<?php
define('DB_HOST', '127.0.0.1');
define('DB_PORT', '9432');
define('DB_NAME', 'listmonk');
define('DB_USER', 'listmonk');
define('DB_PASS', 'your-db-password-here');

define('DASHBOARD_TITLE', 'ZODML Listmonk Analytics');
define('REFRESH_INTERVAL', 30);

define('ADMIN_USER', 'admin');
// Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
define('ADMIN_PASS_HASH', '$2y$10$replace-with-a-real-bcrypt-hash');

function getDB() {
    static $pdo = null;
    if ($pdo === null) {
        try {
            $pdo = new PDO(
                "pgsql:host=" . DB_HOST . ";port=" . DB_PORT . ";dbname=" . DB_NAME,
                DB_USER, DB_PASS,
                [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC]
            );
        } catch (PDOException $e) {
            die(json_encode(['error' => 'DB connection failed: ' . $e->getMessage()]));
        }
    }
    return $pdo;
}
